    {
      "parameters": {
        "jsCode": "// Criar tarefa de lembrete para a propriedade\nconst prop = $('Loop Propriedades').first().json;\nconst hoje = new Date();\nconst hojeStr = hoje.toISOString().split('T')[0];\nconst dia = hoje.getDate();\n\nreturn [{\n  json: {\n    propriedade_id: prop.id,\n    comando_original: `Lembretes Quinzenais - Limpeza Profunda (Dia ${dia})`,\n    descricao: `Limpeza profunda programada para o dia ${dia} do mes`,\n    setor_id: '6319ce3c-5e15-4a12-a0c9-951561008159',\n    setor_interpretado: 'limpeza',\n    status: 'pendente',\n    prioridade: 'alta',\n    origem: 'rotina',\n    rotina_id: '3afef9b4-ddff-4d7f-804a-80ed36fe79b6',\n    data_limite: hojeStr\n  }\n}];"
      },
