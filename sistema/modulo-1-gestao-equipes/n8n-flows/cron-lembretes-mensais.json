    },
    {
      "parameters": {
        "jsCode": "// Criar checklist_items para cada item do lembrete\nconst tarefa = $('Criar Tarefa Lembrete').first().json;\nconst items = $('Buscar Itens Lembretes').all();\nconst tarefaId = Array.isArray(tarefa) ? tarefa[0].id : tarefa.id;\n\nconst result = [];\nfor (const item of items) {\n  result.push({\n    json: {\n      tarefa_id: tarefaId,\n      propriedade_id: item.json.propriedade_id,\n      colaborador_id: item.json.colaborador_id,\n      descricao: item.json.descricao,\n      ordem: item.json.ordem,\n      status: 'pendente'\n    }\n  });\n}\n\nreturn result;"
      },
