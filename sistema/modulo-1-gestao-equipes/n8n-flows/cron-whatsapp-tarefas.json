      "position": [560, 300],
      "id": "get-colaboradores-whats-001",
      "name": "GET Colaboradores com Telefone"
    },
    {
      "parameters": {
        "jsCode": "const colaboradores = $input.item.json;\nconst prop = $('Calcular Data Hoje').item.json;\n\nconst colabList = Array.isArray(colaboradores) ? colaboradores : [colaboradores];\n\nif (!colabList[0] || !colabList[0].id) {\n  return [];\n}\n\nreturn colabList.map(colab => ({\n  json: {\n    colaborador_id: colab.id,\n    colaborador_nome: colab.nome,\n    telefone: colab.telefone,\n    propriedade_id: prop.id,\n    propriedade_nome: prop.nome,\n    evolution_api_url: prop.evolution_api_url || 'https://apiwhats.sitiolabareda.com',\n    evolution_api_key: prop.evolution_instance_token || prop.evolution_api_key || '6726c36d000c9e73ac5ad778752de934',\n    evolution_instance: prop.evolution_instance_name,\n    hoje: prop.hoje\n  }\n}));"
      },
