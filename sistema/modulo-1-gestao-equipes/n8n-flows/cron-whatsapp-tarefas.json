      "id": "get-rotinas-001",
      "name": "GET Rotinas Semanais Ativas"
    },
    {
      "parameters": {
        "jsCode": "const rotinas = $input.all().map(i => i.json);\nconst prop = $('Set Propriedade').item.json;\n\nif (rotinas.length === 0) return [];\n\n// Dia da semana ISO (1=Seg, 7=Dom)\nconst hoje = new Date();\nconst jsDay = hoje.getDay(); // 0=Dom\nconst diaSemanaISO = jsDay === 0 ? 7 : jsDay;\nconst diaDoMes = hoje.getDate();\n\n// Semana do ano (para quinzenal)\nconst startOfYear = new Date(hoje.getFullYear(), 0, 1);\nconst weekNum = Math.ceil(((hoje - startOfYear) / 86400000 + startOfYear.getDay() + 1) / 7);\nconst isSemanaPar = weekNum % 2 === 0;\n\nconst resultados = [];\n\nfor (const rotina of rotinas) {\n  if (!rotina.responsavel_id) continue;\n  if (!rotina.msg_whatsapp) continue;\n  \n  const colab = rotina.colaboradores || {};\n  const telefone = colab.whatsapp_jid || colab.telefone || '';\n  if (!telefone || telefone.includes('00000000')) continue;\n  \n  // Verificar se hoje eh dia de lembrete\n  const diasLembrete = (rotina.dias_lembrete || '').toString();\n  const freq = (rotina.frequencia || 'semanal').toLowerCase();\n  \n  let deveEnviar = false;\n  \n  if (diasLembrete === 'mesmo_dia') {\n    deveEnviar = true;\n  } else {\n    const diasArr = diasLembrete.split(',').map(d => parseInt(d.trim(), 10)).filter(d => !isNaN(d));\n    const hojeNoDias = diasArr.includes(diaSemanaISO);\n    \n    if (freq === 'semanal' && hojeNoDias) {\n      deveEnviar = true;\n    } else if (freq === 'quinzenal' && hojeNoDias && isSemanaPar) {\n      deveEnviar = true;\n    } else if (freq === 'mensal' && (diaDoMes === 1 || diaDoMes === 15)) {\n      deveEnviar = true;\n    }\n  }\n  \n  if (!deveEnviar) continue;\n  \n  // Mensagem da rotina (corrigir URL do painel)\n  let mensagem = rotina.msg_whatsapp;\n  mensagem = mensagem.replace(/https?:\\/\\/sitiolabareda\\.com\\/painel/g, 'https://painel.sitiolabareda.com');\n  mensagem = mensagem.replace(/https?:\\/\\/labareda-gestao\\.netlify\\.app[^\\s]*/g, 'https://painel.sitiolabareda.com');\n  \n  // Formatar telefone\n  let tel = telefone.replace(/\\D/g, '');\n  if (!tel.startsWith('55')) tel = '55' + tel;\n  \n  resultados.push({\n    json: {\n      telefone: tel,\n      mensagem: mensagem,\n      colaborador_nome: colab.nome || 'Colaborador',\n      rotina_nome: rotina.nome,\n      evolution_api_url: prop.evolution_api_url || 'https://apiwhats.sitiolabareda.com',\n      evolution_api_key: prop.evolution_instance_token || prop.evolution_api_key,\n      propriedade_id: prop.id\n    }\n  });\n}\n\nreturn resultados.length > 0 ? resultados : [];"
      },
