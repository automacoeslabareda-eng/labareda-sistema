      "name": "Loop Propriedades"
    },
    {
      "parameters": {
        "jsCode": "const prop = $input.item.json;\nconst now = new Date();\nconst brasilOffset = -3;\nconst brasilTime = new Date(now.getTime() + (brasilOffset * 60 * 60 * 1000 - now.getTimezoneOffset() * 60 * 1000));\nconst hoje = brasilTime.toISOString().split('T')[0];\n\nreturn [\n  {\n    json: {\n      ...prop,\n      hoje: hoje\n    }\n  }\n];"
      },
      "type": "n8n-nodes-base.code",
