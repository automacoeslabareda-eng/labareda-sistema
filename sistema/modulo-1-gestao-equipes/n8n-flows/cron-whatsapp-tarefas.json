      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1040, 300],
      "id": "get-checklist-colab-001",
      "name": "GET Checklist Items do Colaborador"
    },
    {
      "parameters": {
        "jsCode": "const items = $input.item.json;\nconst colab = $('Preparar Colaboradores').item.json;\n\nconst itemsList = Array.isArray(items) ? items : (items && items.id ? [items] : []);\nconst quantidade = itemsList.length;\n\nif (quantidade === 0) {\n  return [];\n}\n\nreturn [\n  {\n    json: {\n      ...colab,\n      quantidade: quantidade,\n      itens: itemsList\n    }\n  }\n];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1280, 300],
      "id": "verificar-tarefas-001",
      "name": "Verificar Se Tem Tarefas"
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "check-qtd",
              "leftValue": "={{ $json.quantidade }}",
              "rightValue": 0,
              "operator": {
                "type": "number",
                "operation": "gt"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [1520, 300],
      "id": "if-tem-tarefas-001",
      "name": "Tem Tarefas?"
    },
    {
      "parameters": {
        "jsCode": "const data = $input.item.json;\n\nconst urlPainel = `https://labareda.sitiolabareda.com/painel`;\n\nconst mensagem = `\\u{1f305} Bom dia ${data.colaborador_nome}!\\n\\nVoce tem tarefas para hoje. Acesse seu painel:\\n\\u{1f449} ${urlPainel}\\n\\n\\u{1f4cb} ${data.quantidade} ${data.quantidade === 1 ? 'item pendente' : 'itens pendentes'}`;\n\n// Formatar telefone: remover tudo que nao for numero, garantir 55 na frente\nlet telefone = data.telefone.replace(/\\D/g, '');\nif (!telefone.startsWith('55')) {\n  telefone = '55' + telefone;\n}\n\nreturn [\n  {\n    json: {\n      telefone: telefone,\n      mensagem: mensagem,\n      evolution_api_url: data.evolution_api_url,\n      evolution_api_key: data.evolution_api_key,\n      evolution_instance: data.evolution_instance\n    }\n  }\n];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1760, 200],
      "id": "montar-msg-whats-001",
      "name": "Montar Mensagem WhatsApp"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $json.evolution_api_url }}/send/text",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "apikey",
              "value": "={{ $json.evolution_api_key }}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"number\": \"{{ $json.telefone }}\",\n  \"text\": {{ JSON.stringify($json.mensagem) }}\n}",
        "options": {}
      },
      "type": "n8n-nodes-base.httpRequest",
