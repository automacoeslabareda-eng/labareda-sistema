    {
      "parameters": {
        "jsCode": "const items = $input.item.json;\nconst prop = $('Set Propriedade').item.json;\n\n// items pode ser array ou objeto unico\nconst itemsList = Array.isArray(items) ? items : (items && items.id ? [items] : []);\n\nif (itemsList.length === 0) {\n  return [];\n}\n\n// Agrupar por colaborador\nconst porColab = {};\nconst itemIds = [];\n\nfor (const item of itemsList) {\n  const colabId = item.colaborador_id;\n  if (!colabId) continue;\n  \n  const colab = item.colaboradores || {};\n  const tarefa = item.tarefas || {};\n  const telefone = colab.whatsapp_jid || colab.telefone || '';\n  \n  if (!telefone || telefone.includes('00000000')) continue;\n  \n  if (!porColab[colabId]) {\n    porColab[colabId] = {\n      colaborador_id: colabId,\n      colaborador_nome: colab.nome || 'Colaborador',\n      telefone: telefone,\n      email: colab.email || '',\n      senha: colab.senha_hash || 'mudar123',\n      itens: [],\n      item_ids: []\n    };\n  }\n  \n  const desc = item.descricao || tarefa.descricao || 'Tarefa sem descricao';\n  porColab[colabId].itens.push(desc);\n  porColab[colabId].item_ids.push(item.id);\n  itemIds.push(item.id);\n}\n\nconst resultados = Object.values(porColab).map(colab => {\n  // Formatar telefone\n  let tel = colab.telefone.replace(/\\D/g, '');\n  if (!tel.startsWith('55')) tel = '55' + tel;\n  \n  // Montar mensagem listando cada tarefa\n  const listaItens = colab.itens.map((item, i) => `  ${i + 1}. ${item}`).join('\\n');\n  \n  const mensagem = `\\u{1f4cb} Ola ${colab.colaborador_nome}!\\n\\nVoce tem ${colab.itens.length} ${colab.itens.length === 1 ? 'tarefa pendente' : 'tarefas pendentes'}:\\n\\n${listaItens}\\n\\n\\u{1f449} Acesse seu painel:\\nhttps://sitiolabareda.com/painel\\n\\n\\u{1f511} Email: ${colab.email}\\n\\u{1f511} Senha: ${colab.senha}\\n\\n\\u{23f0} Preencher ate sexta-feira 16:30!`;\n  \n  return {\n    json: {\n      telefone: tel,\n      mensagem: mensagem,\n      colaborador_nome: colab.colaborador_nome,\n      item_ids: colab.item_ids,\n      evolution_api_url: prop.evolution_api_url || 'https://apiwhats.sitiolabareda.com',\n      evolution_api_key: prop.evolution_instance_token || prop.evolution_api_key,\n      propriedade_id: prop.id\n    }\n  };\n});\n\nreturn resultados.length > 0 ? resultados : [];"
      },
