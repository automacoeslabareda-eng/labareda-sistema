    {
      "parameters": {
        "jsCode": "const rotinas = $input.item.json;\nconst propriedade = $('Calcular Dia Semana').item.json;\n\n// Se nao retornou rotinas ou array vazio, retornar vazio\nif (!rotinas || (Array.isArray(rotinas) && rotinas.length === 0)) {\n  return [];\n}\n\n// Se retornou array, mapear cada rotina\nconst rotinasList = Array.isArray(rotinas) ? rotinas : [rotinas];\n\nreturn rotinasList.map(rotina => ({\n  json: {\n    rotina_id: rotina.id,\n    rotina_nome: rotina.nome,\n    setor_id: rotina.setor_id,\n    setor_nome: rotina.setores ? rotina.setores.nome : 'geral',\n    propriedade_id: propriedade.id,\n    propriedade_nome: propriedade.nome,\n    hoje: propriedade.hoje\n  }\n}));"
      },
