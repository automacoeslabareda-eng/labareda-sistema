    {
      "parameters": {
        "jsCode": "const now = new Date();\nconst brasilOffset = -3;\nconst brasilTime = new Date(now.getTime() + (brasilOffset * 60 * 60 * 1000 - now.getTimezoneOffset() * 60 * 1000));\nconst diaSemana = brasilTime.getDay();\nconst diaMes = brasilTime.getDate();\nconst hoje = brasilTime.toISOString().split('T')[0];\n\n// Calcular inicio e fim da semana (seg-dom)\nconst seg = new Date(brasilTime);\nseg.setDate(brasilTime.getDate() - ((diaSemana + 6) % 7));\nconst dom = new Date(seg);\ndom.setDate(seg.getDate() + 6);\nconst semanaInicio = seg.toISOString().split('T')[0];\nconst semanaFim = dom.toISOString().split('T')[0];\n\n// Semana par/impar do ano (para quinzenal)\nconst inicioAno = new Date(brasilTime.getFullYear(), 0, 1);\nconst semanaAno = Math.ceil(((brasilTime - inicioAno) / 86400000 + inicioAno.getDay() + 1) / 7);\nconst semanaPar = semanaAno % 2 === 0;\n\nreturn [\n  {\n    json: {\n      ...$input.item.json,\n      dia_semana: diaSemana,\n      dia_mes: diaMes,\n      hoje: hoje,\n      semana_inicio: semanaInicio,\n      semana_fim: semanaFim,\n      semana_par: semanaPar\n    }\n  }\n];"
      },
      "type": "n8n-nodes-base.code",
