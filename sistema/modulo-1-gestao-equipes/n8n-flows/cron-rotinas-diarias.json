        "mode": "runOnceForAllItems",
        "jsCode": "const items = $input.all();\nconst rotinas = $('Tem Rotinas?').all();\n\nreturn items.map((item, index) => {\n  const resp = item.json;\n  const rotina = rotinas[index]?.json || {};\n\n  const jaGerou = Array.isArray(resp) ? resp.length > 0 : !!(resp && resp.id);\n\n  return {\n    json: {\n      ...rotina,\n      ja_gerou: jaGerou\n    }\n  };\n});"
      },
