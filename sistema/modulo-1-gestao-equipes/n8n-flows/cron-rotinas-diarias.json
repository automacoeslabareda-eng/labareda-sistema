    },
    {
      "parameters": {
        "jsCode": "const rotinas = $input.item.json;\nconst prop = $('Calcular Dia Semana').item.json;\n\nif (!rotinas || (Array.isArray(rotinas) && rotinas.length === 0)) {\n  return [];\n}\n\nconst lista = Array.isArray(rotinas) ? rotinas : [rotinas];\nconst resultado = [];\n\nfor (const r of lista) {\n  const freq = r.frequencia || 'semanal';\n  let disparar = false;\n\n  if (freq === 'semanal') {\n    disparar = r.dia_semana === prop.dia_semana;\n  } else if (freq === 'quinzenal') {\n    disparar = r.dia_semana === prop.dia_semana && prop.semana_par;\n  } else if (freq === 'mensal') {\n    disparar = r.dia_semana === prop.dia_semana && prop.dia_mes <= 7;\n  }\n\n  if (disparar) {\n    resultado.push({\n      json: {\n        rotina_id: r.id,\n        rotina_nome: r.nome,\n        setor_id: r.setor_id,\n        setor_nome: r.setores ? r.setores.nome : 'geral',\n        propriedade_id: prop.id,\n        propriedade_nome: prop.nome,\n        hoje: prop.hoje,\n        semana_inicio: prop.semana_inicio,\n        semana_fim: prop.semana_fim,\n        frequencia: freq,\n        responsavel_id: r.responsavel_id || null\n      }\n    });\n  }\n}\n\nreturn resultado;"
      },
