    {
      "parameters": {
        "jsCode": "const dados = $input.item.json;\n\n// Montar mensagem\nlet msg = `\\u2705 Tarefa concluida!\\n\\n\\u{1f464} ${dados.colaborador_nome}\\n\\u{1f4cb} ${dados.tarefa_nome}\\n\\u{1f4dd} ${dados.descricao_item}`;\n\nif (dados.observacao && dados.observacao !== '' && dados.observacao !== 'undefined') {\n  msg += `\\n\\u{1f4ac} ${dados.observacao}`;\n}\n\nif (dados.foto_url && dados.foto_url !== '' && dados.foto_url !== 'undefined') {\n  msg += `\\n\\u{1f4f8} Foto anexada`;\n}\n\n// Determinar propriedade\nconst LABAREDA_ID = '229e2813-6d46-4bdb-9aee-5d9a119733e6';\nconst SAO_MIGUEL_ID = '4a5580bb-9971-40c9-9409-ffbe0cff65da';\n\nconst isLabareda = dados.propriedade_id === LABAREDA_ID;\nconst isSaoMiguel = dados.propriedade_id === SAO_MIGUEL_ID;\n\nif (!isLabareda && !isSaoMiguel) {\n  return [\n    {\n      json: {\n        erro: true,\n        mensagem: msg,\n        propriedade: 'desconhecida'\n      }\n    }\n  ];\n}\n\nreturn [\n  {\n    json: {\n      erro: false,\n      mensagem: msg,\n      propriedade: isLabareda ? 'labareda' : 'sao_miguel',\n      chatId: isLabareda ? '-1003848664476' : '-5579671663'\n    }\n  }\n];"
      },
