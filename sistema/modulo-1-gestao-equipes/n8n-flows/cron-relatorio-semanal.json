      "parameters": {
        "jsCode": "const prop = $input.item.json;\n\n// Calcular segunda e sexta da semana atual (horario Brasilia)\nconst now = new Date();\nconst brasilOffset = -3;\nconst brasilTime = new Date(now.getTime() + (brasilOffset * 60 * 60 * 1000 - now.getTimezoneOffset() * 60 * 1000));\n\nconst dayOfWeek = brasilTime.getDay();\n// Segunda = dia atual - (dayOfWeek - 1), ajustando se domingo (0)\nconst diffToMonday = dayOfWeek === 0 ? 6 : dayOfWeek - 1;\nconst segunda = new Date(brasilTime);\nsegunda.setDate(brasilTime.getDate() - diffToMonday);\nsegunda.setHours(0, 0, 0, 0);\n\nconst sexta = new Date(segunda);\nsexta.setDate(segunda.getDate() + 4);\nsexta.setHours(23, 59, 59, 999);\n\nconst sabado = new Date(segunda);\nsabado.setDate(segunda.getDate() + 5);\nsabado.setHours(0, 0, 0, 0);\n\nconst formatDate = (d) => d.toISOString().split('T')[0];\n\n// Determinar propriedade para Telegram\nconst LABAREDA_ID = '229e2813-6d46-4bdb-9aee-5d9a119733e6';\nconst SAO_MIGUEL_ID = '4a5580bb-9971-40c9-9409-ffbe0cff65da';\n\nlet propriedade_slug = 'desconhecida';\nlet chatId = '';\nif (prop.id === LABAREDA_ID) {\n  propriedade_slug = 'labareda';\n  chatId = '-1003848664476';\n} else if (prop.id === SAO_MIGUEL_ID) {\n  propriedade_slug = 'sao_miguel';\n  chatId = '-5579671663';\n}\n\nreturn [\n  {\n    json: {\n      ...prop,\n      semana_inicio: formatDate(segunda),\n      semana_fim: formatDate(sexta),\n      sabado_iso: formatDate(sabado),\n      propriedade_slug: propriedade_slug,\n      telegram_chat_id: chatId\n    }\n  }\n];"
      },
