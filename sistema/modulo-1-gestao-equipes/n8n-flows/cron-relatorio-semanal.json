      "id": "get-checklist-semana-001",
      "name": "GET Checklist Items da Semana"
    },
    {
      "parameters": {
        "jsCode": "const checklistItems = $input.item.json;\nconst propData = $('Preparar Tarefas').item.json;\n\nconst items = Array.isArray(checklistItems) ? checklistItems : (checklistItems && checklistItems.id ? [checklistItems] : []);\nconst tarefas = propData.tarefas;\n\n// Metricas gerais\nconst totalItems = items.length;\nconst concluidos = items.filter(i => i.status === 'concluido').length;\nconst pendentes = totalItems - concluidos;\nconst percentual = totalItems > 0 ? Math.round((concluidos / totalItems) * 100) : 0;\n\n// Por colaborador\nconst porColaborador = {};\nitems.forEach(item => {\n  const nome = item.colaboradores ? item.colaboradores.nome : 'Sem atribuicao';\n  if (!porColaborador[nome]) {\n    porColaborador[nome] = { total: 0, concluidos: 0 };\n  }\n  porColaborador[nome].total++;\n  if (item.status === 'concluido') {\n    porColaborador[nome].concluidos++;\n  }\n});\n\n// Por setor\nconst porSetor = {};\ntarefas.forEach(tarefa => {\n  const setor = tarefa.setores ? tarefa.setores.nome : (tarefa.setor_interpretado || 'geral');\n  if (!porSetor[setor]) {\n    porSetor[setor] = { total: 0, concluidos: 0 };\n  }\n  const tarefaItems = items.filter(i => i.tarefa_id === tarefa.id);\n  porSetor[setor].total += tarefaItems.length;\n  porSetor[setor].concluidos += tarefaItems.filter(i => i.status === 'concluido').length;\n});\n\n// Montar mensagem\nlet msg = `\\u{1f4ca} Relatorio Semanal \\u2014 ${propData.nome}\\n`;\nmsg += `\\u{1f4c5} ${propData.semana_inicio} a ${propData.semana_fim}\\n\\n`;\nmsg += `\\u{1f4cb} Total de itens: ${totalItems}\\n`;\nmsg += `\\u2705 Concluidos: ${concluidos} (${percentual}%)\\n`;\nmsg += `\\u23f3 Pendentes: ${pendentes}\\n\\n`;\n\nmsg += `\\u{1f465} Por colaborador:\\n`;\nObject.entries(porColaborador).forEach(([nome, dados]) => {\n  msg += `  \\u2022 ${nome}: ${dados.concluidos}/${dados.total} concluidos\\n`;\n});\n\nmsg += `\\n\\u{1f3f7}\\ufe0f Por setor:\\n`;\nObject.entries(porSetor).forEach(([setor, dados]) => {\n  msg += `  \\u2022 ${setor}: ${dados.concluidos}/${dados.total} concluidos\\n`;\n});\n\n// Dados JSON para salvar\nconst dadosJson = {\n  porColaborador,\n  porSetor,\n  items: items.length\n};\n\nreturn [\n  {\n    json: {\n      propriedade_id: propData.id,\n      propriedade_nome: propData.nome,\n      propriedade_slug: propData.propriedade_slug,\n      telegram_chat_id: propData.telegram_chat_id,\n      semana_inicio: propData.semana_inicio,\n      semana_fim: propData.semana_fim,\n      total_tarefas: propData.total_tarefas,\n      tarefas_concluidas: concluidos,\n      tarefas_pendentes: pendentes,\n      percentual_conclusao: percentual,\n      dados_json: JSON.stringify(dadosJson),\n      mensagem: msg\n    }\n  }\n];"
      },
