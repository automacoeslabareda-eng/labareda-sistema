    {
      "parameters": {
        "jsCode": "const tarefas = $input.item.json;\nconst prop = $('Calcular Semana').item.json;\n\nconst tarefasList = Array.isArray(tarefas) ? tarefas : (tarefas && tarefas.id ? [tarefas] : []);\n\nif (tarefasList.length === 0) {\n  return [\n    {\n      json: {\n        ...prop,\n        tarefas: [],\n        tarefa_ids: '',\n        total_tarefas: 0,\n        sem_tarefas: true\n      }\n    }\n  ];\n}\n\nconst ids = tarefasList.map(t => t.id);\n\nreturn [\n  {\n    json: {\n      ...prop,\n      tarefas: tarefasList,\n      tarefa_ids: '(' + ids.join(',') + ')',\n      total_tarefas: tarefasList.length,\n      sem_tarefas: false\n    }\n  }\n];"
      },
