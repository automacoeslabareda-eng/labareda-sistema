    {
      "parameters": {
        "jsCode": "const tarefas = $input.all().map(item => item.json);\n\nif (tarefas.length === 0) {\n  return [{ json: { result: 'Nenhuma tarefa pendente encontrada.' } }];\n}\n\nconst lista = tarefas.map((t, i) => {\n  const desc = t.comando_original || 'Sem descricao';\n  const setor = t.setor_interpretado || 'geral';\n  const status = t.status || 'pendente';\n  const prio = t.prioridade || 'normal';\n  const pct = t.porcentagem_conclusao || 0;\n  const origem = t.origem || 'dashboard';\n  return `${i+1}. [${t.id.substring(0,8)}] ${desc} | Setor: ${setor} | Status: ${status} | Prioridade: ${prio} | Conclusao: ${pct}% | Origem: ${origem}`;\n}).join('\\n');\n\nreturn [{ json: { result: `${tarefas.length} tarefa(s) encontrada(s):\\n${lista}` } }];"
      },
