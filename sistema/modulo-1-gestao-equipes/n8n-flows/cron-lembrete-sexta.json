      "name": "GET Tarefas Pendentes"
    },
    {
      "parameters": {
        "jsCode": "const items = $input.item.json;\nconst prop = $('Loop Propriedades').item.json;\n\nconst itemsList = Array.isArray(items) ? items : (items && items.colaborador_id ? [items] : []);\nif (itemsList.length === 0) return [];\n\n// Agrupar por colaborador (pegar unicos)\nconst vistos = {};\nconst resultado = [];\n\nfor (const item of itemsList) {\n  const colabId = item.colaborador_id;\n  if (!colabId || vistos[colabId]) continue;\n  vistos[colabId] = true;\n\n  const colab = item.colaboradores || {};\n  let tel = (colab.whatsapp_jid || colab.telefone || '').replace(/\\D/g, '');\n  if (!tel || tel.includes('00000000')) continue;\n  if (!tel.startsWith('55')) tel = '55' + tel;\n\n  // Contar pendentes deste colab\n  const pendentes = itemsList.filter(i => i.colaborador_id === colabId).length;\n\n  const msg = `\\u{23f0} Bom dia ${colab.nome}!\\n\\nHoje e sexta-feira! Voce tem ${pendentes} ${pendentes === 1 ? 'tarefa pendente' : 'tarefas pendentes'} para preencher.\\n\\n\\u{1f4cb} Prazo: hoje ate 16:30\\n\\n\\u{1f449} Acesse seu painel:\\nhttps://sitiolabareda.com/painel\\n\\n\\u{1f511} Email: ${colab.email || ''}\\n\\u{1f511} Senha: ${colab.senha_hash || 'mudar123'}`;\n\n  resultado.push({\n    json: {\n      telefone: tel,\n      mensagem: msg,\n      evolution_api_url: prop.evolution_api_url,\n      evolution_api_key: prop.evolution_instance_token\n    }\n  });\n}\n\nreturn resultado;"
      },
